# Copy to .env (gitignored) and adjust. Scripts auto-source it.
# Precedence: shell env > .env > script defaults.
PROJECT_ID=ml-pipelines-315702
REGION=europe-west4
ZONE=europe-west4-a
BUCKET=llm-architectures-eu

# Repo the TPU VM clones + runs
REPO_URL=https://github.com/cataluna84/llm-architectures.git
REPO_BRANCH=feat/nanoGPTJAX

# Baseline smoke defaults (raise TOTAL_TRAIN_STEPS for the full run)
DATA_SOURCE=hf
DATA_SHARDS=2
TOTAL_TRAIN_STEPS=50
# PER_DEVICE_BATCH_SIZE=16     # uncomment to shrink on OOM
# SAVE_CKPT_DIR=gs://llm-architectures-eu/nanogptjax/checkpoints/pretrain
