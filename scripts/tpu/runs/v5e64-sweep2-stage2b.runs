# Sweep v2, Stage 2b — the "everything" extension (10 runs, 1000 steps).
# User directive: every literature value is a hypothesis on this hardware.
# Betas and momentum are swept here despite Keller/nanochat saying don't
# bother — that advice was earned on different hardware, which is the point.
#
# Also carries the two numerics/memory controls:
#  - accum2: per-device 2 x accum 2 = same 524,288 tokens/step, same data —
#    isolates gradient-accumulation order as a numerics source (explains the
#    v6e-8 gap, or exonerates it). VAL_MAX_BATCHES=50 keeps 6,400 val rows.
#  - mudtype: Muon momentum buffer bf16 vs the current f32 — the one HBM knob
#    that is also a numerics knob.

TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MUON_MOMENTUM_MAX=0.90 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=mommax WANDB_RUN_NAME=v5e64-mommax-090
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MUON_MOMENTUM_MAX=0.98 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=mommax WANDB_RUN_NAME=v5e64-mommax-098
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MUON_MOMENTUM_WARMUP_STEPS=100 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=momwu WANDB_RUN_NAME=v5e64-momwu-100
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MUON_MOMENTUM_WARMUP_STEPS=600 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=momwu WANDB_RUN_NAME=v5e64-momwu-600
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_ADAM_B1=0.9 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=adamb WANDB_RUN_NAME=v5e64-b1-090
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_ADAM_B2=0.99 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=adamb WANDB_RUN_NAME=v5e64-b2-099
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_GRAD_CLIP_NORM=0.5 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=clip WANDB_RUN_NAME=v5e64-clip-05
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_GRAD_CLIP_NORM=2.0 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=clip WANDB_RUN_NAME=v5e64-clip-20
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=accum WANDB_RUN_NAME=v5e64-accum2
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MU_DTYPE=bfloat16 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=mudtype WANDB_RUN_NAME=v5e64-mudtype-bf16
