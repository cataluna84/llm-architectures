# v5e-64 LR sweep matrix — executed in order by sweep_runner.sh.
# Batch math: PER_DEVICE_BATCH_SIZE=2 x 64 chips x 2048 x accum 2 = 524,288
# tokens/step = B_ref (same as every v6e-8 run); VAL_MAX_BATCHES=50 x 128 rows
# = the exact 6,400-row val subset the v6e-8 sweep scored. v5e peak 197e12.

# 1. multi-host smoke gate (50 steps) — validates the 16-host rendezvous
TOTAL_TRAIN_STEPS=50 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 WANDB_RUN_NAME=v5e64-smoke

# 2-5. the sweep matrix (1000 steps each)
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 WANDB_RUN_NAME=v5e64-lrsweep-020
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_OTHER_PEAK_LR=0.014 WANDB_RUN_NAME=v5e64-lrsweep-014
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_OTHER_PEAK_LR=0.028 WANDB_RUN_NAME=v5e64-lrsweep-028
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=2 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=50 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_MUON_MOMENTUM_WARMUP_STEPS=0 WANDB_RUN_NAME=v5e64-lrsweep-020-nomom
