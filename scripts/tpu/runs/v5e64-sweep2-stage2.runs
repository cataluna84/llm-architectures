# Sweep v2, Stage 2 — optimizer-internals probes (8 runs, 1000 steps).
# One factor at a time vs the seed-0 baseline (LR 0.02, momentum warmup ON,
# embedding_lr 0.2, unembedding_lr 0.004, warmup 10@1000, cautious_wd 0.01).
#
# Axis rationale (Exa research 2026-07-20):
#  - unembedding LR: most LR-sensitive per-layer group (Scion norm-transfer)
#  - embedding LR: the other unswept per-group LR
#  - warmup: the default at 1000 steps is min(300, 1%*steps) = 10 steps —
#    suspiciously tiny; the result also decides the 10k run's override
#  - cautious WD: Keller Jordan — only LR and WD need tuning; 0.01 never swept
# Adam betas deliberately NOT swept (nanochat ablations: sharp optima).
#
# Adoption rule: > 2*sigma_seed improvement (from Stage 1) or the nanochat
# default stays. Adopted changes get one combined confirmation run.

TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_EMBEDDING_LR=0.1 WANDB_RUN_NAME=v5e64-emblr-010
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_EMBEDDING_LR=0.3 WANDB_RUN_NAME=v5e64-emblr-030
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_UNEMBEDDING_LR=0.002 WANDB_RUN_NAME=v5e64-unemb-002
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_UNEMBEDDING_LR=0.008 WANDB_RUN_NAME=v5e64-unemb-008
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_WARMUP_STEPS=100 WANDB_RUN_NAME=v5e64-warmup-100
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_WARMUP_STEPS=300 WANDB_RUN_NAME=v5e64-warmup-300
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_CAUTIOUS_WD=0.0 WANDB_RUN_NAME=v5e64-cwd-000
TOTAL_TRAIN_STEPS=1000 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 NANOGPT_CAUTIOUS_WD=0.1 WANDB_RUN_NAME=v5e64-cwd-010
