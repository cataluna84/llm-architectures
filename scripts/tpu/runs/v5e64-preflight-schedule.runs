# Pre-flight for the 10k: schedule A/B on the COMPOSED config (2 runs, 2500
# steps, ~30 min). WSD-0.65 beat cosine by ~21 sigma at this horizon on the
# DEFAULT config; the composition was validated on cosine. This measures the
# one untested interaction before committing the baseline.
#
# Decision rule: winner at step 2446 by >2 sigma takes the 10k; a tie goes
# to WSD-0.65 (its default-config margin is the prior).

TOTAL_TRAIN_STEPS=2500 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 RUN_TIMEOUT_SECONDS=2700 NANOGPT_EMBEDDING_LR=0.3 NANOGPT_UNEMBEDDING_LR=0.002 NANOGPT_CAUTIOUS_WD=0.2 NANOGPT_GRAD_CLIP_NORM=0.5 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=preflight WANDB_RUN_NAME=v5e64-composed-cos-2500
TOTAL_TRAIN_STEPS=2500 PER_DEVICE_BATCH_SIZE=4 DATA_SHARDS=60 NANOGPT_VAL_MAX_BATCHES=25 NANOGPT_DEVICE_PEAK_FLOPS=197e12 RUN_TIMEOUT_SECONDS=2700 NANOGPT_EMBEDDING_LR=0.3 NANOGPT_UNEMBEDDING_LR=0.002 NANOGPT_CAUTIOUS_WD=0.2 NANOGPT_GRAD_CLIP_NORM=0.5 NANOGPT_LR_SCHEDULE=wsd NANOGPT_WSD_WARMDOWN_FRAC=0.65 WANDB_RUN_GROUP=sweep2-v5e64 WANDB_JOB_TYPE=preflight WANDB_RUN_NAME=v5e64-composed-wsd-2500
